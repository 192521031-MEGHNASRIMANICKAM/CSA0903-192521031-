import java.lang.management.ManagementFactory;

/* PREDICTION (made before running):
   '+' in a loop copies the whole growing string every iteration -> O(n^2) chars, n new Strings.
   StringBuilder/StringBuffer append in place (amortised O(1)) -> O(n).
   Short tickets: difference negligible. Long tickets (20,000 fields): '+' orders of magnitude slower.
   StringBuffer ~ StringBuilder single-threaded (uncontended lock), slightly slower. */
public class TicketBench {
    static final com.sun.management.ThreadMXBean MX =
        (com.sun.management.ThreadMXBean) ManagementFactory.getThreadMXBean();
    static long alloc() { return MX.getThreadAllocatedBytes(Thread.currentThread().getId()); }
    static int sink;

    static String[] fields(int n) { String[] f = new String[n]; for (int i = 0; i < n; i++) f[i] = "F" + i; return f; }
    static String plus(String[] f) { String s = ""; for (String x : f) s = s + x + "|"; return s; }
    static String sb(String[] f) { StringBuilder b = new StringBuilder(); for (String x : f) b.append(x).append('|'); return b.toString(); }
    static String sbuf(String[] f) { StringBuffer b = new StringBuffer(); for (String x : f) b.append(x).append('|'); return b.toString(); }
    interface Gen { String apply(String[] f); }

    static void run(String wl, String name, Gen g, String[] f, int tickets, int runs, boolean plusMode) {
        int warm = Math.max(2, runs / 5);
        for (int w = 0; w < warm; w++) for (int t = 0; t < tickets; t++) sink += g.apply(f).length();
        long a0 = alloc(), t0 = System.nanoTime();
        for (int r = 0; r < runs; r++) for (int t = 0; t < tickets; t++) sink += g.apply(f).length();
        double us = (System.nanoTime() - t0) / 1e3 / runs;
        double mb = (alloc() - a0) / 1048576.0 / runs;
        long inter = (plusMode ? f.length : 1L) * tickets;   // estimated intermediate Strings per run
        System.out.printf("%-30s %-14s %14.1f %14d %12.2f%n", wl, name, us, inter, mb);
    }

    public static void main(String[] a) throws Exception {
        System.out.printf("%-30s %-14s %14s %14s %12s%n", "Workload", "Approach", "avg time (us)", "interm.Strings", "alloc (MB)");
        System.out.println("-".repeat(88));
        Object[][] wls = {
            {"W1: 1 ticket x 10 fields", 10, 1, 100000},
            {"W2: 10,000 tickets x 50 fields", 50, 10000, 10},
            {"W3: 1 ticket x 20,000 fields", 20000, 1, 5}};
        for (Object[] w : wls) {
            String[] f = fields((int) w[1]);
            run((String) w[0], "String +", TicketBench::plus, f, (int) w[2], (int) w[3], true);
            run((String) w[0], "StringBuilder", TicketBench::sb, f, (int) w[2], (int) w[3], false);
            run((String) w[0], "StringBuffer", TicketBench::sbuf, f, (int) w[2], (int) w[3], false);
            System.out.println();
        }
        // Shared booking log: 8 threads x 1,000,000 appends, 5 trials each
        final int T = 8, N = 1000000;
        System.out.println("Shared log, " + T + " threads x " + N + " appends, 5 trials (expected length " + T * N + "):");
        for (int k = 0; k < 2; k++) {
            final boolean safe = k == 1;
            StringBuilder res = new StringBuilder();
            for (int trial = 0; trial < 5; trial++) {
                final StringBuilder unsafe = new StringBuilder();
                final StringBuffer buf = new StringBuffer();
                Thread[] ts = new Thread[T];
                final java.util.concurrent.CyclicBarrier gate = new java.util.concurrent.CyclicBarrier(T);
                try {
                    for (int i = 0; i < T; i++) { ts[i] = new Thread(() -> { try { gate.await(); } catch (Exception e) { } try { for (int j = 0; j < N; j++) { if (safe) buf.append('x'); else unsafe.append('x'); } } catch (RuntimeException e) { /* race corrupted the builder */ } }); ts[i].start(); }
                    for (Thread t : ts) t.join();
                    res.append(safe ? buf.length() : unsafe.length()).append("  ");
                } catch (Exception e) { res.append("EXC(" + e.getClass().getSimpleName() + ")  "); }
            }
            System.out.printf("  %-14s %s%n", safe ? "StringBuffer" : "StringBuilder", res);
        }
    }
}
